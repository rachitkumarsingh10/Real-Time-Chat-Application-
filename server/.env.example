# Server Port
PORT=5000

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL(s) for CORS (comma-separated for multiple origins, or * for all)
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# MongoDB Connection URI (e.g. MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# Cloudinary Credentials (from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key (Get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
